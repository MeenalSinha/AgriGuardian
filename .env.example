# ==============================================================================
# AGRI-GUARDIAN ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure your local settings.
# NEVER commit real credentials or .env to version control.

# --- Application Settings ---
APP_NAME=AgriGuardian
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# --- AI & LLM Settings ---
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=600
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_RETRIES=2

# --- Gnani AI Voice Intelligence ---
# Base API URL for Gnani speech services (official endpoint)
GNANI_API_BASE_URL=https://api.vachana.ai
# Your Gnani AI API Key (sent via X-API-Key-ID header)
GNANI_API_KEY=your_gnani_api_key_here

# Gnani Prisma v2.5 Speech-to-Text (STT) Settings
GNANI_PRISMA_MODEL=prisma-v2.5
GNANI_PRISMA_ENDPOINT=/stt/v3
GNANI_PRISMA_DEFAULT_LANGUAGE=hi-IN
GNANI_PRISMA_TIMEOUT_SECONDS=20.0
GNANI_PRISMA_MAX_RETRIES=2

# Gnani Timbre v2.5 Text-to-Speech (TTS) Settings
GNANI_TIMBRE_MODEL=timbre-v2.5
GNANI_TIMBRE_ENDPOINT=/api/v1/tts/inference
GNANI_TIMBRE_DEFAULT_VOICE=Nalini
GNANI_TIMBRE_DEFAULT_LANGUAGE=hi-IN
GNANI_TIMBRE_SPEED=1.0
GNANI_TIMBRE_SAMPLE_RATE=48000
GNANI_TIMBRE_CONTAINER=wav
GNANI_TIMBRE_ENCODING=linear_pcm
GNANI_TIMBRE_TIMEOUT_SECONDS=25.0
GNANI_TIMBRE_MAX_RETRIES=2

# --- Weather API Settings ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
DEFAULT_LATITUDE=28.6139
DEFAULT_LONGITUDE=77.2090
DEFAULT_LOCATION_NAME=Delhi, India
WEATHER_CACHE_TTL_SECONDS=3600
WEATHER_TIMEOUT_SECONDS=8.0

# --- Market Intelligence Settings ---
MARKET_CACHE_TTL_SECONDS=1800
MARKET_TIMEOUT_SECONDS=5.0

# --- Storage and File System ---
DATA_DIR=data
AUDIO_TEMP_DIR=audio
REPORTS_DIR=reports
LOGS_DIR=logs
CONFIG_DIR=config
BACKUP_DIR=backups
MAX_AUDIO_SIZE_BYTES=10485760
MAX_AUDIO_DURATION_SECONDS=60
CLEANUP_TEMP_FILES=true

# --- Security, Authentication & Production Settings (Phase 12) ---
# Mandatory 32+ character high-entropy key in production
JWT_SECRET_KEY=your_production_high_entropy_32_character_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8000,http://127.0.0.1:8501,http://127.0.0.1:8000
# Database connection: leave empty for default SQLite (data/farm_guardian.db) or set PostgreSQL URI
DATABASE_URL=
# Production API documentation exposure (false by default in production)
ENABLE_DOCS_IN_PROD=false
# Request rate limiting
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=300

# --- Feature Flags ---
FEATURE_VOICE_ASSISTANT=true
FEATURE_GRADCAM=true
FEATURE_PDF_EXPORT=true

